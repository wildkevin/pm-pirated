{
  "name": "pm-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Postman-like API client",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@postman/tough-cookie": "4.1.3-postman.1",
    "csv-parse": "7.0.3",
    "curl-to-postmanv2": "1.8.7",
    "node-forge": "1.4.0",
    "postman-code-generators": "2.1.1",
    "postman-collection": "5.3.1",
    "postman-runtime": "7.56.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "allotment": "1.20.6",
    "codemirror": "6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "postcss": "8.5.29",
    "electron-to-chromium": "1.5.452",
    "caniuse-lite": "1.0.30001815",
    "@peculiar/asn1-schema": "2.10.0",
    "http-cache-semantics": "4.2.0"
  },
  "build": {
    "appId": "local.pmlocal.app",
    "productName": "PM Local",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PM-Local-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "PM-Local-${version}-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": null
    }
  }
}
