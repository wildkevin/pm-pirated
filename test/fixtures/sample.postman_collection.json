{
  "info": {
    "_postman_id": "0d3a9c1e-1111-4a8b-9c3d-2f8e5b7a6c10",
    "name": "Sample API",
    "description": "Imported from Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "description": "User endpoints",
      "auth": { "type": "apikey", "apikey": [{ "key": "key", "value": "X-Api-Key", "type": "string" }, { "key": "value", "value": "{{apiKey}}", "type": "string" }] },
      "item": [
        {
          "name": "Get user",
          "event": [{ "listen": "test", "script": { "exec": "pm.test(\"ok\", function () {\n  pm.response.to.have.status(200)\n})", "type": "text/javascript" } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-Old", "value": "1", "disabled": true }],
            "url": {
              "raw": "{{baseUrl}}/users/:id?expand=true",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "query": [{ "key": "expand", "value": "true" }, { "key": "debug", "value": "1", "disabled": true }],
              "variable": [{ "key": "id", "value": "42", "description": "User id" }]
            }
          },
          "response": [{ "name": "Example", "code": 200, "body": "{}" }]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": "Content-Type: application/json\nX-Trace: on",
            "body": { "mode": "raw", "raw": "{\"name\":\"Ada\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    { "name": "Health", "request": "https://api.example.test/health" },
    { "name": "Empty event", "event": [{ "listen": "prerequest" }], "request": { "method": "get", "url": { "host": ["example", "test"], "path": ["ping"], "protocol": "https" } } }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "event": [{ "listen": "prerequest", "script": { "exec": ["console.log('collection')"], "type": "text/javascript" } }],
  "variable": [{ "key": "baseUrl", "value": "https://api.example.test" }, { "key": "apiKey", "value": "s3cret", "type": "secret" }, { "key": "off", "value": "x", "disabled": true }]
}
